{
  "name": "tailscale",
  "description": "Tailscale application for Cockpit",
  "main": "dist/index.html",
  "repository": "https://github.com/Nicolazroyale/cockpit-tailscaled.git",
  "author": "Nicolazroyale",
  "version": "0.1.0",
  "license": "LGPL-2.1-or-later",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "test:unit": "esbuild src/services/tailscale.test.ts --bundle --platform=node --format=cjs --outfile=.tmp-unit/tailscale.test.cjs && node --test .tmp-unit/tailscale.test.cjs",
    "rpm": "make rpm",
    "link": "mkdir -p ~/.local/share/cockpit && ln -s $PWD/dist ~/.local/share/cockpit/tailscale",
    "unlink": "rm ~/.local/share/cockpit/tailscale",
    "linkusr": "sudo mkdir -p /usr/local/share/cockpit && sudo ln -s $PWD/dist /usr/local/share/cockpit/tailscale",
    "unlinkusr": "sudo rm /usr/local/share/cockpit/tailscale",
    "cockpit": "sudo runuser -u cockpit-wsinstance -- /usr/libexec/cockpit-ws --port=9090 --for-tls-proxy"
  },
  "dependencies": {
    "@patternfly/patternfly": "5.4.2",
    "@patternfly/react-core": "5.4.14",
    "@patternfly/react-icons": "5.4.2",
    "@patternfly/react-styles": "5.4.1",
    "@patternfly/react-table": "5.4.16",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "catalog:",
    "esbuild-plugin-replace": "^2.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "sass": "^1.103.1",
    "typescript": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
